{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://krishi-bot-uypg.onrender.com/api/$1"
    },
    {
      "source": "/docs",
      "destination": "https://krishi-bot-uypg.onrender.com/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://krishi-bot-uypg.onrender.com/openapi.json"
    },
    {
      "source": "/redoc",
      "destination": "https://krishi-bot-uypg.onrender.com/redoc"
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
